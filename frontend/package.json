{
  "name": "frontend",
  "private": true,
  "version": "4.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "i18n:check": "node scripts/sync-i18n.mjs --check",
    "i18n:add": "node scripts/i18n-add.mjs",
    "test:e2e": "playwright test --ignore-snapshots -g '^(?!.*Visual Regression).*'",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test visual.spec.ts --update-snapshots",
    "test:visual:ci": "playwright test visual.spec.ts --update-snapshots",
    "swagger": "swagger-ui-watcher ../backend/openapi.yaml -p 5174",
    "version:patch": "node ../scripts/bump-version.mjs patch",
    "version:minor": "node ../scripts/bump-version.mjs minor",
    "version:major": "node ../scripts/bump-version.mjs major"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.3.6",
    "jassub": "^2.5.16",
    "libpgs": "^0.9.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.1.0",
    "oxlint": "^1.75.0",
    "swagger-ui-watcher": "^2.1.14",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "^3.15.2",
    "qs": "^6.16.0"
  }
}
